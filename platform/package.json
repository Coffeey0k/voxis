{
  "name": "voxis-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "services/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm --workspace @voxis/api run dev",
    "dev:web": "npm --workspace @voxis/web run dev",
    "build": "npm --workspaces run build",
    "typecheck": "npm --workspaces run typecheck",
    "test": "npm --workspace @voxis/api test"
  },
  "engines": {
    "node": ">=22"
  }
}